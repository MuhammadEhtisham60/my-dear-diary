PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://<db_user>:<db_password>@<neon-host>/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (for Forgot Password OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Chronicle Diary <your-email@gmail.com>"
